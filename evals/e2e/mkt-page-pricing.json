[["set","viewport","1440","900"],
["open","{URL}"],
["wait","#pricing article"],
["wait","--fn","document.querySelectorAll('#pricing article').length === 3"],
["wait","--fn","[...document.querySelectorAll('#pricing article h3')].map(e => e.textContent).join('|').includes('Most popular')"],
["wait","--fn","document.fonts.check('40px \"IBM Plex Mono\"') && getComputedStyle(document.querySelector('#pricing article span.font-mono')).fontFamily.includes('IBM Plex Mono')"],
["wait","--fn","[...document.querySelectorAll('#pricing article a')].map(a => a.getAttribute('href')).every(h => h.startsWith('mailto:sales@harbor.example'))"],
["find","text","See pricing","click"],
["wait","--fn","Math.abs(document.querySelector('#pricing').getBoundingClientRect().top) < 120"],
["find","role","link","hover","--name","Talk to sales"],
["screenshot","{SHOTS}/pricing-1440.png"],
["set","viewport","375","812"],
["scrollintoview","#pricing"],
["wait","--fn","document.documentElement.scrollWidth <= 375"],
["screenshot","{SHOTS}/pricing-375.png"]]
